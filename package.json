{
  "name": "flow-atlas",
  "version": "0.1.0",
  "description": "Find cross-component flow problems in a monorepo while you develop: surfaces nobody calls, calls nothing serves, undeclared boundary calls, registry entries without a producer, and contract versions nobody uses.",
  "type": "module",
  "license": "MIT",
  "private": true,
  "bin": {
    "atlas": "dist/cli.js"
  },
  "files": [
    "dist",
    "schema",
    "skills"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "check": "pnpm -s typecheck && pnpm -s lint",
    "test": "vitest run",
    "atlas": "node dist/cli.js",
    "prepare": "node scripts/hooks.mjs && tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "picomatch": "^4.0.7",
    "typescript": "^5.9.3",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.5",
    "@types/picomatch": "^4.0.3",
    "ajv-draft-04": "^1.0.0",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hellices/flow-atlas.git"
  },
  "homepage": "https://github.com/hellices/flow-atlas#readme",
  "bugs": {
    "url": "https://github.com/hellices/flow-atlas/issues"
  },
  "keywords": [
    "agent-skills",
    "monorepo",
    "architecture",
    "static-analysis",
    "openapi",
    "sarif",
    "arazzo"
  ]
}
