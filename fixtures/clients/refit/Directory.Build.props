<Project>
  <PropertyGroup>
    <!-- The packages the projects use: Refit with its IHttpClientFactory registration, and the .NET 10 generic host. -->
    <RefitVersion Condition="'$(RefitVersion)' == ''">16.4.0</RefitVersion>
    <ExtensionsVersion Condition="'$(ExtensionsVersion)' == ''">10.0.14</ExtensionsVersion>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>
</Project>
