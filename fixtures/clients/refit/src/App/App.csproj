<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="$(ExtensionsVersion)" />
    <PackageReference Include="Refit" Version="$(RefitVersion)" />
    <PackageReference Include="Refit.HttpClientFactory" Version="$(RefitVersion)" />
    <PackageReference Include="Refit.Reflection" Version="$(RefitVersion)" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
