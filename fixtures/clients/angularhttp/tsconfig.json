{
  "compilerOptions": {
    "module": "commonjs",
    "moduleResolution": "bundler",
    "experimentalDecorators": true,
    "target": "ES2022",
    "useDefineForClassFields": false,
    "outDir": "./dist",
    "rootDir": "./src",
    "skipLibCheck": true,
    "strict": true,
    "types": []
  },
  "include": ["src"]
}
