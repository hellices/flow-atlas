{
  "framework": "actix-web",
  "version": "4.18.2",
  "routes": [
    {"method":"GET","path":"/"},
    {"method":"POST","path":"/"},
    {"method":"GET","path":"/a/{}/{}","raw":"/a/{v1}/{v2}/"},
    {"method":"GET","path":"/accounts"},
    {"method":"POST","path":"/accounts"},
    {"method":"DELETE","path":"/accounts/{}","raw":"/accounts/{account_id}"},
    {"method":"GET","path":"/accounts/{}","raw":"/accounts/{account_id}"},
    {"method":"GET","path":"/api/health"},
    {"method":"GET","path":"/api/v1/users"},
    {"method":"POST","path":"/api/v1/users"},
    {"method":"DELETE","path":"/api/v1/users/{}","raw":"/api/v1/users/{id}"},
    {"method":"GET","path":"/api/v1/users/{}","raw":"/api/v1/users/{id}"},
    {"method":"PUT","path":"/api/v1/users/{}","raw":"/api/v1/users/{id}"},
    {"method":"GET","path":"/api/v1/users/{}/posts","raw":"/api/v1/users/{id}/posts"},
    {"method":"GET","path":"/api/v1/users/{}/posts/{}","raw":"/api/v1/users/{id}/posts/{post_id}"},
    {"method":"GET","path":"/files/{}.{}","raw":"/files/{name}.{ext}"},
    {"method":"GET","path":"/foo/{}","raw":"/foo/{bar}/{tail:.*}"},
    {"method":"GET","path":"/foo/{}.html","raw":"/foo/{name}.html"},
    {"method":"GET","path":"/foo/{}/{**}","raw":"/foo/{bar}/{tail:.*}"},
    {"method":"PATCH","path":"/items/{}","raw":"/items/{id:\\d+}"},
    {"method":"*","path":"/old"},
    {"method":"GET","path":"/path"},
    {"method":"GET","path":"/ping"},
    {"method":"POST","path":"/ping"},
    {"method":"*","path":"/prefix"},
    {"method":"GET","path":"/static"},
    {"method":"GET","path":"/static/{**}","raw":"/static"},
    {"method":"POST","path":"/user"},
    {"method":"GET","path":"/user/{}","raw":"/user/{name}"},
    {"method":"PUT","path":"/user/{}","raw":"/user/{name}"}
  ]
}
