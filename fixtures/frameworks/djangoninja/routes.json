{
  "framework": "django-ninja",
  "version": "1.7.3, django 6.1.2",
  "routes": [
    {"method":"GET","path":"/","raw":"^\\Z"},
    {"method":"GET","path":"/api/add/{}/{}","raw":"^api/add/(?P<a>[^/]+)/(?P<b>[^/]+)\\Z"},
    {"method":"GET","path":"/api/add/{}/{}/multiply/{}","raw":"^api/add/(?P<a>[^/]+)/(?P<b>[^/]+)/multiply/(?P<c>[^/]+)\\Z"},
    {"method":"GET","path":"/api/dir/{**}","raw":"^api/dir/(?P<value>.+)\\Z"},
    {"method":"*","path":"/api/docs","raw":"^api/docs\\Z"},
    {"method":"GET","path":"/api/events","raw":"^api/events/\\Z"},
    {"method":"GET","path":"/api/events/{}","raw":"^api/events/(?P<event_id>[^/]+)\\Z"},
    {"method":"GET","path":"/api/events/{}/{}/{}","raw":"^api/events/(?P<year>[^/]+)/(?P<month>[^/]+)/(?P<day>[^/]+)\\Z"},
    {"method":"GET","path":"/api/hello","raw":"^api/hello\\Z"},
    {"method":"POST","path":"/api/hello","raw":"^api/hello\\Z"},
    {"method":"DELETE","path":"/api/hello/{}","raw":"^api/hello/(?P<id>[^/]+)\\Z"},
    {"method":"PATCH","path":"/api/hello/{}","raw":"^api/hello/(?P<id>[^/]+)\\Z"},
    {"method":"PUT","path":"/api/hello/{}","raw":"^api/hello/(?P<id>[^/]+)\\Z"},
    {"method":"GET","path":"/api/items/{}","raw":"^api/items/(?P<item_id>[0-9]+)\\Z"},
    {"method":"GET","path":"/api/l1/add","raw":"^api/l1/add\\Z"},
    {"method":"GET","path":"/api/l1/l2/add","raw":"^api/l1/l2/add\\Z"},
    {"method":"GET","path":"/api/l1/l2/l3/add","raw":"^api/l1/l2/l3/add\\Z"},
    {"method":"GET","path":"/api/news","raw":"^api/news/\\Z"},
    {"method":"POST","path":"/api/news","raw":"^api/news/\\Z"},
    {"method":"*","path":"/api/openapi.json","raw":"^api/openapi\\.json\\Z"},
    {"method":"GET","path":"/api/slugs/{}","raw":"^api/slugs/(?P<slug>[-a-zA-Z0-9_]+)\\Z"},
    {"method":"GET","path":"/api/tasks","raw":"^api/tasks\\Z"},
    {"method":"HEAD","path":"/api/tasks","raw":"^api/tasks\\Z"},
    {"method":"OPTIONS","path":"/api/tasks","raw":"^api/tasks\\Z"},
    {"method":"PATCH","path":"/api/tasks/{}","raw":"^api/tasks/(?P<task_id>[^/]+)\\Z"},
    {"method":"POST","path":"/api/tasks/{}","raw":"^api/tasks/(?P<task_id>[^/]+)\\Z"},
    {"method":"GET","path":"/api/tokens/{}","raw":"^api/tokens/(?P<token>[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12})\\Z"},
    {"method":"*","path":"/api/v1/docs","raw":"^api/v1/docs\\Z"},
    {"method":"GET","path":"/api/v1/items","raw":"^api/v1/items\\Z"},
    {"method":"*","path":"/api/v1/openapi.json","raw":"^api/v1/openapi\\.json\\Z"},
    {"method":"GET","path":"/api/v1/things","raw":"^api/v1/things/\\Z"},
    {"method":"DELETE","path":"/api/v1/things/{}","raw":"^api/v1/things/(?P<thing_id>[0-9]+)\\Z"},
    {"method":"GET","path":"/api/v2/hello","raw":"^api/v2/hello\\Z"},
    {"method":"GET","path":"/api/v2/items","raw":"^api/v2/items\\Z"},
    {"method":"*","path":"/api/v2/openapi.json","raw":"^api/v2/openapi\\.json\\Z"},
    {"method":"GET","path":"/api/v2/things","raw":"^api/v2/things/\\Z"},
    {"method":"DELETE","path":"/api/v2/things/{}","raw":"^api/v2/things/(?P<thing_id>[0-9]+)\\Z"}
  ]
}
