{
  "framework": "chi",
  "version": "5.5.0",
  "routes": [
    {"method":"GET","path":"/"},
    {"method":"HEAD","path":"/"},
    {"method":"POST","path":"/"},
    {"method":"GET","path":"/admin","raw":"/admin/"},
    {"method":"GET","path":"/admin/accounts"},
    {"method":"GET","path":"/admin/users/{}","raw":"/admin/users/{userID:[0-9]+}/"},
    {"method":"POST","path":"/admin/users/{}/ban","raw":"/admin/users/{userID:[0-9]+}/ban"},
    {"method":"GET","path":"/api/articles/{}-{}","raw":"/api/articles/{date}-{slug}"},
    {"method":"GET","path":"/articles","raw":"/articles/"},
    {"method":"POST","path":"/articles","raw":"/articles/"},
    {"method":"DELETE","path":"/articles/{}","raw":"/articles/{articleID}/"},
    {"method":"GET","path":"/articles/{}","raw":"/articles/{articleID}/"},
    {"method":"GET","path":"/articles/{}","raw":"/articles/{articleSlug:[a-z-]+}"},
    {"method":"PUT","path":"/articles/{}","raw":"/articles/{articleID}/"},
    {"method":"GET","path":"/articles/{}-{}-{}","raw":"/articles/{month}-{day}-{year}"},
    {"method":"GET","path":"/articles/{}/revisions","raw":"/articles/{rid:^[0-9]{5,6}}/revisions"},
    {"method":"GET","path":"/articles/search"},
    {"method":"GET","path":"/assets/{}","raw":"/assets/{assetURL}"},
    {"method":"GET","path":"/files","raw":"/files/"},
    {"method":"GET","path":"/files/{**}","raw":"/files/*"},
    {"method":"*","path":"/handled"},
    {"method":"JELLO","path":"/jello"},
    {"method":"POST","path":"/manage"},
    {"method":"GET","path":"/manage/id/{}","raw":"/manage/id/{path}"},
    {"method":"GET","path":"/manage/url/{}","raw":"/manage/url/{path}"},
    {"method":"GET","path":"/method-func"},
    {"method":"*","path":"/ping"},
    {"method":"*","path":"/public","raw":"/public/"},
    {"method":"*","path":"/public/{**}","raw":"/public/*"},
    {"method":"OPTIONS","path":"/things"},
    {"method":"DELETE","path":"/things/{}","raw":"/things/{id}"},
    {"method":"PATCH","path":"/things/{}","raw":"/things/{id}"},
    {"method":"PUT","path":"/things/{}","raw":"/things/{id}"}
  ]
}
