{
  "framework": "hono",
  "version": "4.13.14",
  "routes": [
    {"method":"DELETE","path":"/"},
    {"method":"GET","path":"/"},
    {"method":"POST","path":"/"},
    {"method":"PUT","path":"/"},
    {"method":"GET","path":"/{**}","raw":"/*"},
    {"method":"GET","path":"/animal"},
    {"method":"GET","path":"/animal/{}","raw":"/animal/:type"},
    {"method":"GET","path":"/api/catalog"},
    {"method":"PATCH","path":"/api/v1/settings/{}","raw":"/api/v1/settings/:key"},
    {"method":"GET","path":"/api/v1/status"},
    {"method":"GET","path":"/book"},
    {"method":"POST","path":"/book"},
    {"method":"GET","path":"/book/{}","raw":"/book/:id"},
    {"method":"PURGE","path":"/cache"},
    {"method":"GET","path":"/en/greet"},
    {"method":"DELETE","path":"/endpoint"},
    {"method":"GET","path":"/endpoint"},
    {"method":"POST","path":"/endpoint"},
    {"method":"GET","path":"/greet"},
    {"method":"*","path":"/hello"},
    {"method":"GET","path":"/ja/greet"},
    {"method":"DELETE","path":"/post"},
    {"method":"PUT","path":"/post"},
    {"method":"GET","path":"/post/{}/{}","raw":"/post/:date{[0-9]+}/:title{[a-z]+}"},
    {"method":"GET","path":"/posts/{}/comment/{}","raw":"/posts/:id/comment/:comment_id"},
    {"method":"QUERY","path":"/search"},
    {"method":"GET","path":"/user/{}","raw":"/user/:name"},
    {"method":"GET","path":"/users"},
    {"method":"POST","path":"/users"},
    {"method":"GET","path":"/wild/{}/card","raw":"/wild/*/card"}
  ]
}
