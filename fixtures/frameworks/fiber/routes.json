{
  "framework": "fiber",
  "version": "3.6.1",
  "routes": [
    {"method":"GET","path":"/"},
    {"method":"HEAD","path":"/"},
    {"method":"GET","path":"/{**}","raw":"/*"},
    {"method":"HEAD","path":"/{**}","raw":"/*"},
    {"method":"GET","path":"/about"},
    {"method":"HEAD","path":"/about"},
    {"method":"GET","path":"/accounts/{}","raw":"/accounts/:username<minLen(4);maxLen(16)>"},
    {"method":"HEAD","path":"/accounts/{}","raw":"/accounts/:username<minLen(4);maxLen(16)>"},
    {"method":"GET","path":"/admin/users"},
    {"method":"HEAD","path":"/admin/users"},
    {"method":"POST","path":"/admin/users"},
    {"method":"GET","path":"/api-{}","raw":"/api-:version"},
    {"method":"HEAD","path":"/api-{}","raw":"/api-:version"},
    {"method":"GET","path":"/api/v1/list"},
    {"method":"HEAD","path":"/api/v1/list"},
    {"method":"GET","path":"/api/v1/user"},
    {"method":"HEAD","path":"/api/v1/user"},
    {"method":"GET","path":"/api/v2/list"},
    {"method":"HEAD","path":"/api/v2/list"},
    {"method":"GET","path":"/api/v2/user"},
    {"method":"HEAD","path":"/api/v2/user"},
    {"method":"GET","path":"/docs","raw":"/docs/*"},
    {"method":"HEAD","path":"/docs","raw":"/docs/*"},
    {"method":"GET","path":"/docs/{**}","raw":"/docs/*"},
    {"method":"HEAD","path":"/docs/{**}","raw":"/docs/*"},
    {"method":"GET","path":"/events"},
    {"method":"HEAD","path":"/events"},
    {"method":"POST","path":"/events"},
    {"method":"GET","path":"/files/{**}","raw":"/files/+"},
    {"method":"HEAD","path":"/files/{**}","raw":"/files/+"},
    {"method":"GET","path":"/form"},
    {"method":"HEAD","path":"/form"},
    {"method":"POST","path":"/form"},
    {"method":"PUT","path":"/form"},
    {"method":"DELETE","path":"/form/{}","raw":"/form/:id"},
    {"method":"PATCH","path":"/form/{}","raw":"/form/:id"},
    {"method":"GET","path":"/john/doe"},
    {"method":"HEAD","path":"/john/doe"},
    {"method":"PUT","path":"/john/doe/{}","raw":"/john/doe/:id"},
    {"method":"GET","path":"/legacy"},
    {"method":"HEAD","path":"/legacy"},
    {"method":"GET","path":"/orders/{}","raw":"/orders/:id<int>"},
    {"method":"HEAD","path":"/orders/{}","raw":"/orders/:id<int>"},
    {"method":"*","path":"/ping"},
    {"method":"GET","path":"/random.txt"},
    {"method":"HEAD","path":"/random.txt"},
    {"method":"GET","path":"/reports","raw":"/reports/:year<int>?"},
    {"method":"HEAD","path":"/reports","raw":"/reports/:year<int>?"},
    {"method":"GET","path":"/reports/{}","raw":"/reports/:year<int>?"},
    {"method":"HEAD","path":"/reports/{}","raw":"/reports/:year<int>?"},
    {"method":"GET","path":"/reports/daily"},
    {"method":"HEAD","path":"/reports/daily"},
    {"method":"GET","path":"/sessions/{}","raw":"/sessions/:id<guid>"},
    {"method":"HEAD","path":"/sessions/{}","raw":"/sessions/:id<guid>"},
    {"method":"GET","path":"/shop/product/color:{}/size:{}","raw":"/shop/product/color::color/size::size"},
    {"method":"HEAD","path":"/shop/product/color:{}/size:{}","raw":"/shop/product/color::color/size::size"},
    {"method":"GET","path":"/t/{}/dashboard","raw":"/t/:tenant/dashboard"},
    {"method":"HEAD","path":"/t/{}/dashboard","raw":"/t/:tenant/dashboard"},
    {"method":"GET","path":"/user","raw":"/user/:name?"},
    {"method":"HEAD","path":"/user","raw":"/user/:name?"},
    {"method":"GET","path":"/user/{}","raw":"/user/:name?"},
    {"method":"HEAD","path":"/user/{}","raw":"/user/:name?"},
    {"method":"GET","path":"/user/{}/books/{}","raw":"/user/:name/books/:title"},
    {"method":"HEAD","path":"/user/{}/books/{}","raw":"/user/:name/books/:title"},
    {"method":"GET","path":"/v1/some/resource/name:verify","raw":"/v1/some/resource/name\\:verify"},
    {"method":"HEAD","path":"/v1/some/resource/name:verify","raw":"/v1/some/resource/name\\:verify"}
  ]
}
