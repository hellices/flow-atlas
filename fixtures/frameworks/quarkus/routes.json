{
  "framework": "quarkus",
  "version": "3.40.1.1",
  "routes": [
    {"method":"GET","path":"/accounts/{}","raw":"/accounts/:id"},
    {"method":"GET","path":"/accounts/me"},
    {"method":"CHEESE","path":"/api/cheeses/{}","raw":"/api/cheeses/{cheese}/"},
    {"method":"GET","path":"/api/cheeses/{}","raw":"/api/cheeses/{cheese}/"},
    {"method":"GET","path":"/api/fruits","raw":"/api/fruits/"},
    {"method":"POST","path":"/api/fruits","raw":"/api/fruits/"},
    {"method":"DELETE","path":"/api/fruits/{}","raw":"/api/fruits/{id: \\d+}"},
    {"method":"GET","path":"/api/fruits/{}","raw":"/api/fruits/{id: \\d+}"},
    {"method":"PATCH","path":"/api/fruits/{}","raw":"/api/fruits/{id: \\d+}"},
    {"method":"PUT","path":"/api/fruits/{}","raw":"/api/fruits/{id: \\d+}"},
    {"method":"GET","path":"/api/fruits/{}-{}.json","raw":"/api/fruits/{name: [a-z]+}-{version}.json"},
    {"method":"GET","path":"/api/fruits/{}/seeds","raw":"/api/fruits/{id: \\d+}/seeds/"},
    {"method":"POST","path":"/api/fruits/{}/seeds","raw":"/api/fruits/{id: \\d+}/seeds/"},
    {"method":"GET","path":"/api/fruits/{}/seeds/{}","raw":"/api/fruits/{id: \\d+}/seeds/{seed}"},
    {"method":"POST","path":"/api/greetings","raw":"/api/greetings/"},
    {"method":"GET","path":"/api/greetings/{}","raw":"/api/greetings/{name}"},
    {"method":"GET","path":"/api/hello","raw":"/api/hello/"},
    {"method":"GET","path":"/api/hello/{}/{}","raw":"/api/hello/{name}/{age:\\d+}"},
    {"method":"GET","path":"/assets","raw":"/assets/*"},
    {"method":"GET","path":"/assets/{**}","raw":"/assets/*"},
    {"method":"POST","path":"/first"},
    {"method":"GET","path":"/greetings"},
    {"method":"GET","path":"/greetings/{}","raw":"/greetings/:name"},
    {"method":"GET","path":"/hello"},
    {"method":"GET","path":"/my-route"},
    {"method":"*","path":"/my-route/{}","raw":"/my-route/:id"},
    {"method":"DELETE","path":"/second"},
    {"method":"PUT","path":"/second"},
    {"method":"POST","path":"/simple/echo"},
    {"method":"*","path":"/simple/ping"},
    {"method":"*","path":"/world"}
  ]
}
