{
  "framework": "nuxt",
  "version": "4.6.3",
  "routes": [
    {"method":"*","path":"/"},
    {"method":"*","path":"/__nuxt_island/{**}","raw":"/__nuxt_island/**"},
    {"method":"GET","path":"/_nuxt/{**}","raw":"/_nuxt/**"},
    {"method":"*","path":"/about"},
    {"method":"POST","path":"/api/auth/{**}","raw":"/api/auth/**:slug"},
    {"method":"*","path":"/api/files/{**}","raw":"/api/files/**"},
    {"method":"*","path":"/api/hello"},
    {"method":"GET","path":"/api/items"},
    {"method":"POST","path":"/api/items"},
    {"method":"DELETE","path":"/api/items/{}","raw":"/api/items/:id"},
    {"method":"GET","path":"/api/items/{}","raw":"/api/items/:id"},
    {"method":"PUT","path":"/api/items/{}","raw":"/api/items/:id"},
    {"method":"GET","path":"/api/legacy"},
    {"method":"PATCH","path":"/api/users/{}/profile","raw":"/api/users/:id/profile"},
    {"method":"*","path":"/bonjour"},
    {"method":"*","path":"/docs","raw":"/docs/:slug?"},
    {"method":"*","path":"/docs/{}","raw":"/docs/:slug?"},
    {"method":"GET","path":"/feeds/{}","raw":"/feeds/:name"},
    {"method":"*","path":"/files","raw":"/files/:path(.*)*"},
    {"method":"*","path":"/files/{**}","raw":"/files/:path(.*)*"},
    {"method":"GET","path":"/images/logo.svg","raw":"public/images/logo.svg"},
    {"method":"*","path":"/items"},
    {"method":"*","path":"/items/{}","raw":"/items/:id()"},
    {"method":"*","path":"/old-home"},
    {"method":"*","path":"/parent"},
    {"method":"*","path":"/parent/{}","raw":"/parent/:tab()"},
    {"method":"*","path":"/parent/child"},
    {"method":"*","path":"/pricing"},
    {"method":"GET","path":"/robots.txt","raw":"public/robots.txt"},
    {"method":"GET","path":"/sitemap.xml"},
    {"method":"*","path":"/users-{}/{}","raw":"/users-:group()/:id()"}
  ]
}
