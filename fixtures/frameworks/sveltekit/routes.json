{
  "framework": "@sveltejs/kit",
  "version": "3.1.1",
  "routes": [
    {"method":"GET","path":"/"},
    {"method":"*","path":"/_app/env.js"},
    {"method":"GET","path":"/_app/immutable/{**}","raw":"/_app/immutable/*"},
    {"method":"GET","path":"/_app/version.json","raw":"client/_app/version.json"},
    {"method":"GET","path":"/{}/home","raw":"/[[lang=locale]]/home"},
    {"method":"GET","path":"/about"},
    {"method":"*","path":"/api/echo"},
    {"method":"GET","path":"/api/files","raw":"/api/files/[...path]"},
    {"method":"GET","path":"/api/files/{**}","raw":"/api/files/[...path]"},
    {"method":"GET","path":"/api/items"},
    {"method":"POST","path":"/api/items"},
    {"method":"DELETE","path":"/api/items/{}","raw":"/api/items/[id=integer]"},
    {"method":"GET","path":"/api/items/{}","raw":"/api/items/[id=integer]"},
    {"method":"PUT","path":"/api/items/{}","raw":"/api/items/[id=integer]"},
    {"method":"PATCH","path":"/api/users/{}","raw":"/api/users/[id]"},
    {"method":"GET","path":"/blog/{}","raw":"/blog/[slug]"},
    {"method":"GET","path":"/contact"},
    {"method":"PUT","path":"/contact"},
    {"method":"GET","path":"/dashboard","raw":"/(app)/dashboard"},
    {"method":"GET","path":"/docs","raw":"/docs/[...rest]"},
    {"method":"GET","path":"/docs/{**}","raw":"/docs/[...rest]"},
    {"method":"GET","path":"/files/{}.{}","raw":"/files/[name].[ext]"},
    {"method":"GET","path":"/home","raw":"/[[lang=locale]]/home"},
    {"method":"GET","path":"/images/logo.svg","raw":"client/images/logo.svg"},
    {"method":"GET","path":"/items/{}","raw":"/items/[id=integer]"},
    {"method":"GET","path":"/login"},
    {"method":"POST","path":"/login"},
    {"method":"GET","path":"/pricing","raw":"/(marketing)/pricing"},
    {"method":"GET","path":"/robots.txt","raw":"client/robots.txt"},
    {"method":"GET","path":"/settings","raw":"/(app)/settings"},
    {"method":"GET","path":"/sitemap.xml"},
    {"method":"GET","path":"/todos"},
    {"method":"POST","path":"/todos"}
  ]
}
