<Project>
  <PropertyGroup>
    <!-- The packages the projects use: FastEndpoints, and the ASP.NET Core test host at the release of the shared framework they run on. -->
    <FastEndpointsVersion Condition="'$(FastEndpointsVersion)' == ''">8.3.0</FastEndpointsVersion>
    <AspNetCoreVersion Condition="'$(AspNetCoreVersion)' == ''">10.0.14</AspNetCoreVersion>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>
</Project>
