{
  "framework": "tornado",
  "version": "6.6",
  "routes": [
    {"method":"GET","path":"/","raw":"/$"},
    {"method":"GET","path":"/admin","raw":"/admin$"},
    {"method":"GET","path":"/admin/settings","raw":"/admin/settings$"},
    {"method":"POST","path":"/admin/settings","raw":"/admin/settings$"},
    {"method":"DELETE","path":"/api/items/{}","raw":"/api/items/([0-9]+)$"},
    {"method":"GET","path":"/api/items/{}","raw":"/api/items/([0-9]+)$"},
    {"method":"GET","path":"/api/status","raw":"/api/status$"},
    {"method":"GET","path":"/app","raw":"/app$"},
    {"method":"GET","path":"/assets","raw":"/assets/(.*)$"},
    {"method":"HEAD","path":"/assets","raw":"/assets/(.*)$"},
    {"method":"GET","path":"/assets/{**}","raw":"/assets/(.*)$"},
    {"method":"HEAD","path":"/assets/{**}","raw":"/assets/(.*)$"},
    {"method":"GET","path":"/blog/{}/{}","raw":"/blog/(?P<year>[0-9]{4})/(?P<slug>[^/]+)$"},
    {"method":"GET","path":"/favicon.ico","raw":"/(favicon\\.ico)$"},
    {"method":"HEAD","path":"/favicon.ico","raw":"/(favicon\\.ico)$"},
    {"method":"GET","path":"/files/{}.txt","raw":"/files/([^/]+)\\.txt$"},
    {"method":"HEAD","path":"/files/{}.txt","raw":"/files/([^/]+)\\.txt$"},
    {"method":"GET","path":"/myform","raw":"/myform$"},
    {"method":"POST","path":"/myform","raw":"/myform$"},
    {"method":"GET","path":"/photos","raw":"/photos/(.*)$"},
    {"method":"GET","path":"/photos/{**}","raw":"/photos/(.*)$"},
    {"method":"GET","path":"/pictures","raw":"/pictures/(.*)$"},
    {"method":"GET","path":"/pictures/{**}","raw":"/pictures/(.*)$"},
    {"method":"GET","path":"/robots.txt","raw":"/(robots\\.txt)$"},
    {"method":"HEAD","path":"/robots.txt","raw":"/(robots\\.txt)$"},
    {"method":"GET","path":"/static","raw":"/static/(.*)$"},
    {"method":"HEAD","path":"/static","raw":"/static/(.*)$"},
    {"method":"GET","path":"/static/{**}","raw":"/static/(.*)$"},
    {"method":"HEAD","path":"/static/{**}","raw":"/static/(.*)$"},
    {"method":"GET","path":"/story/{}","raw":"/story/([0-9]+)$"},
    {"method":"GET","path":"/users","raw":"/users$"},
    {"method":"POST","path":"/users","raw":"/users$"},
    {"method":"DELETE","path":"/users/{}","raw":"/users/([^/]+)$"},
    {"method":"GET","path":"/users/{}","raw":"/users/([^/]+)$"},
    {"method":"PATCH","path":"/users/{}","raw":"/users/([^/]+)$"},
    {"method":"PUT","path":"/users/{}","raw":"/users/([^/]+)$"},
    {"method":"GET","path":"/users/{}/profile","raw":"/users/([^/]+)/profile$"},
    {"method":"PATCH","path":"/users/{}/profile","raw":"/users/([^/]+)/profile$"},
    {"method":"PUT","path":"/users/{}/profile","raw":"/users/([^/]+)/profile$"},
    {"method":"GET","path":"/websocket","raw":"/websocket$"}
  ]
}
