{
  "framework": "rocket",
  "version": "0.5.2",
  "routes": [
    {"method":"GET","path":"/"},
    {"method":"POST","path":"/"},
    {"method":"GET","path":"/{**}","raw":"/<_..>"},
    {"method":"GET","path":"/admin"},
    {"method":"GET","path":"/admin/login"},
    {"method":"GET","path":"/api/v1/users"},
    {"method":"POST","path":"/api/v1/users"},
    {"method":"DELETE","path":"/api/v1/users/{}","raw":"/api/v1/users/<id>"},
    {"method":"GET","path":"/api/v1/users/{}","raw":"/api/v1/users/<id>"},
    {"method":"GET","path":"/api/v1/users/{}/posts/{}","raw":"/api/v1/users/<id>/posts/<post_id>"},
    {"method":"GET","path":"/api/v2/users/{}","raw":"/api/v2/users/<id>"},
    {"method":"GET","path":"/custom/{}/{}","raw":"/custom/<a>/<b>"},
    {"method":"GET","path":"/foo/{}/bar","raw":"/foo/<_>/bar"},
    {"method":"GET","path":"/hello/{}","raw":"/hello/<name>"},
    {"method":"GET","path":"/hello/{}/{}/{}","raw":"/hello/<name>/<age>/<cool>"},
    {"method":"DELETE","path":"/items/{}","raw":"/items/<id>"},
    {"method":"PATCH","path":"/items/{}","raw":"/items/<id>"},
    {"method":"PUT","path":"/items/{}","raw":"/items/<id>"},
    {"method":"GET","path":"/manual/{}","raw":"/manual/<id>"},
    {"method":"GET","path":"/page","raw":"/page/<path..>"},
    {"method":"GET","path":"/page/{**}","raw":"/page/<path..>"},
    {"method":"GET","path":"/search","raw":"/search?<q>&<page>"},
    {"method":"GET","path":"/static","raw":"/static/<path..>"},
    {"method":"GET","path":"/static/{**}","raw":"/static/<path..>"},
    {"method":"HEAD","path":"/status"},
    {"method":"OPTIONS","path":"/status"},
    {"method":"GET","path":"/user/{}","raw":"/user/<id>"}
  ]
}
