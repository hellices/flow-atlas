{
  "framework": "aiohttp",
  "version": "3.14.5",
  "routes": [
    {"method":"GET","path":"/"},
    {"method":"HEAD","path":"/"},
    {"method":"GET","path":"/admin","raw":"/admin/"},
    {"method":"HEAD","path":"/admin","raw":"/admin/"},
    {"method":"DELETE","path":"/admin/audit"},
    {"method":"GET","path":"/admin/audit"},
    {"method":"HEAD","path":"/admin/audit"},
    {"method":"GET","path":"/downloads","raw":"/downloads/{tail}"},
    {"method":"HEAD","path":"/downloads","raw":"/downloads/{tail}"},
    {"method":"GET","path":"/downloads/{**}","raw":"/downloads/{tail}"},
    {"method":"HEAD","path":"/downloads/{**}","raw":"/downloads/{tail}"},
    {"method":"GET","path":"/flights/{}-{}","raw":"/flights/{origin}-{destination}"},
    {"method":"HEAD","path":"/flights/{}-{}","raw":"/flights/{origin}-{destination}"},
    {"method":"GET","path":"/health"},
    {"method":"DELETE","path":"/items/{}","raw":"/items/{item_id}"},
    {"method":"GET","path":"/items/{}","raw":"/items/{item_id}"},
    {"method":"PUT","path":"/items/{}","raw":"/items/{item_id}"},
    {"method":"POST","path":"/orders"},
    {"method":"GET","path":"/orders/{}","raw":"/orders/{order_id}"},
    {"method":"PATCH","path":"/orders/{}","raw":"/orders/{order_id}"},
    {"method":"*","path":"/ping"},
    {"method":"GET","path":"/reports/{}/{}","raw":"/reports/{year}/{name}"},
    {"method":"HEAD","path":"/reports/{}/{}","raw":"/reports/{year}/{name}"},
    {"method":"GET","path":"/static"},
    {"method":"HEAD","path":"/static"},
    {"method":"GET","path":"/static/{**}","raw":"/static"},
    {"method":"HEAD","path":"/static/{**}","raw":"/static"},
    {"method":"GET","path":"/users"},
    {"method":"HEAD","path":"/users"},
    {"method":"POST","path":"/users"},
    {"method":"GET","path":"/users/{}","raw":"/users/{name}"},
    {"method":"HEAD","path":"/users/{}","raw":"/users/{name}"}
  ]
}
