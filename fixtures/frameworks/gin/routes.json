{
  "framework": "gin",
  "version": "1.12.0",
  "routes": [
    {"method":"GET","path":"/"},
    {"method":"DELETE","path":"/admin/cache"},
    {"method":"GET","path":"/admin/dashboard"},
    {"method":"*","path":"/anything"},
    {"method":"GET","path":"/api/health"},
    {"method":"GET","path":"/api/v1/posts","raw":"/api/v1/posts/"},
    {"method":"GET","path":"/api/v1/posts/{}","raw":"/api/v1/posts/:id"},
    {"method":"GET","path":"/api/v1/users","raw":"/api/v1/users/"},
    {"method":"GET","path":"/api/v1/users/{}","raw":"/api/v1/users/:id"},
    {"method":"GET","path":"/assets","raw":"/assets/"},
    {"method":"HEAD","path":"/assets","raw":"/assets/"},
    {"method":"GET","path":"/assets/{**}","raw":"/assets/*filepath"},
    {"method":"HEAD","path":"/assets/{**}","raw":"/assets/*filepath"},
    {"method":"GET","path":"/favicon.ico"},
    {"method":"HEAD","path":"/favicon.ico"},
    {"method":"POST","path":"/handled"},
    {"method":"GET","path":"/match"},
    {"method":"POST","path":"/match"},
    {"method":"GET","path":"/more_static","raw":"/more_static/"},
    {"method":"HEAD","path":"/more_static","raw":"/more_static/"},
    {"method":"GET","path":"/more_static/{**}","raw":"/more_static/*filepath"},
    {"method":"HEAD","path":"/more_static/{**}","raw":"/more_static/*filepath"},
    {"method":"DELETE","path":"/someDelete"},
    {"method":"GET","path":"/someGet"},
    {"method":"HEAD","path":"/someHead"},
    {"method":"OPTIONS","path":"/someOptions"},
    {"method":"PATCH","path":"/somePatch"},
    {"method":"POST","path":"/somePost"},
    {"method":"PUT","path":"/somePut"},
    {"method":"GET","path":"/user/{}","raw":"/user/:name"},
    {"method":"POST","path":"/user/{}","raw":"/user/:name/"},
    {"method":"GET","path":"/user/{}/{**}","raw":"/user/:name/*action"},
    {"method":"POST","path":"/user/{}/{**}","raw":"/user/:name/*action"},
    {"method":"POST","path":"/v1/login"},
    {"method":"POST","path":"/v1/read"},
    {"method":"POST","path":"/v1/submit"},
    {"method":"POST","path":"/v2/login"},
    {"method":"POST","path":"/v2/read"},
    {"method":"POST","path":"/v2/submit"}
  ]
}
