{
  "framework": "symfony",
  "version": "8.1.11",
  "routes": [
    {"method":"*","path":"/"},
    {"method":"*","path":"/_error/{}","raw":"/_error/{code}.{_format}"},
    {"method":"*","path":"/_error/{}.{}","raw":"/_error/{code}.{_format}"},
    {"method":"*","path":"/{}/search","raw":"/{_locale}/search.{_format}"},
    {"method":"*","path":"/{}/search.{}","raw":"/{_locale}/search.{_format}"},
    {"method":"*","path":"/about-us"},
    {"method":"GET","path":"/admin/products"},
    {"method":"GET","path":"/admin/products/{}","raw":"/admin/products/{id}"},
    {"method":"GET","path":"/admin/products/{}/edit","raw":"/admin/products/{id}/edit"},
    {"method":"POST","path":"/admin/products/{}/edit","raw":"/admin/products/{id}/edit"},
    {"method":"GET","path":"/api/status"},
    {"method":"GET","path":"/api/v1/orders"},
    {"method":"POST","path":"/api/v1/orders"},
    {"method":"GET","path":"/api/v1/orders/{}","raw":"/api/v1/orders/{id}"},
    {"method":"GET","path":"/blog"},
    {"method":"POST","path":"/blog"},
    {"method":"DELETE","path":"/blog/{}","raw":"/blog/{slug}"},
    {"method":"GET","path":"/blog/{}","raw":"/blog/{slug}"},
    {"method":"HEAD","path":"/blog/{}","raw":"/blog/{slug}"},
    {"method":"PATCH","path":"/blog/{}","raw":"/blog/{slug}"},
    {"method":"PUT","path":"/blog/{}","raw":"/blog/{slug}"},
    {"method":"GET","path":"/blog/{}/comments","raw":"/blog/{slug}/comments"},
    {"method":"GET","path":"/blog/{}/comments","raw":"/blog/{slug}/comments/{id}"},
    {"method":"GET","path":"/blog/{}/comments/{}","raw":"/blog/{slug}/comments/{id}"},
    {"method":"GET","path":"/blog/archive","raw":"/blog/archive/{year}"},
    {"method":"GET","path":"/blog/archive/{}","raw":"/blog/archive/{year}"},
    {"method":"GET","path":"/blog/page","raw":"/blog/page/{page}"},
    {"method":"GET","path":"/blog/page/{}","raw":"/blog/page/{page}"},
    {"method":"GET","path":"/contact"},
    {"method":"POST","path":"/contact"},
    {"method":"GET","path":"/docs","raw":"/docs/{page}"},
    {"method":"GET","path":"/docs/{}","raw":"/docs/{page}"},
    {"method":"GET","path":"/files/{**}","raw":"/files/{path}"},
    {"method":"*","path":"/flights/{}-{}","raw":"/flights/{from}-{to}"},
    {"method":"*","path":"/old-blog"},
    {"method":"*","path":"/over-ons"},
    {"method":"GET","path":"/report"},
    {"method":"*","path":"/share/{**}","raw":"/share/{token}"},
    {"method":"GET","path":"/user/{}","raw":"/user/{id}"}
  ]
}
