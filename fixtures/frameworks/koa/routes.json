{
  "framework": "@koa/router",
  "version": "15.7.0",
  "routes": [
    {"method":"GET","path":"/"},
    {"method":"HEAD","path":"/"},
    {"method":"GET","path":"/api/posts"},
    {"method":"HEAD","path":"/api/posts"},
    {"method":"GET","path":"/api/posts/{}","raw":"/api/posts/:id"},
    {"method":"HEAD","path":"/api/posts/{}","raw":"/api/posts/:id"},
    {"method":"POST","path":"/api/posts/{}/likes","raw":"/api/posts/:id/likes"},
    {"method":"GET","path":"/api/users"},
    {"method":"HEAD","path":"/api/users"},
    {"method":"GET","path":"/api/users/{}","raw":"/api/users/:id"},
    {"method":"HEAD","path":"/api/users/{}","raw":"/api/users/:id"},
    {"method":"GET","path":"/api/v{}/legacy","raw":"/api/v:version/legacy"},
    {"method":"HEAD","path":"/api/v{}/legacy","raw":"/api/v:version/legacy"},
    {"method":"GET","path":"/api/v{}/legacy/items","raw":"/api/v:version/legacy/items"},
    {"method":"HEAD","path":"/api/v{}/legacy/items","raw":"/api/v:version/legacy/items"},
    {"method":"GET","path":"/api/v{}/status","raw":"/api/v:version/status"},
    {"method":"HEAD","path":"/api/v{}/status","raw":"/api/v:version/status"},
    {"method":"GET","path":"/archive/{**}","raw":"/archive/*\"rest-path\""},
    {"method":"HEAD","path":"/archive/{**}","raw":"/archive/*\"rest-path\""},
    {"method":"GET","path":"/articles/{}","raw":"/articles/:article"},
    {"method":"HEAD","path":"/articles/{}","raw":"/articles/:article"},
    {"method":"GET","path":"/articles/{}/comments","raw":"/articles/:article/comments"},
    {"method":"HEAD","path":"/articles/{}/comments","raw":"/articles/:article/comments"},
    {"method":"PURGE","path":"/cache/{}","raw":"/cache/:key"},
    {"method":"GET","path":"/dashboard"},
    {"method":"HEAD","path":"/dashboard"},
    {"method":"GET","path":"/downloads/{}","raw":"/downloads/:\"file-name\""},
    {"method":"HEAD","path":"/downloads/{}","raw":"/downloads/:\"file-name\""},
    {"method":"GET","path":"/files/{**}","raw":"/files/*path"},
    {"method":"HEAD","path":"/files/{**}","raw":"/files/*path"},
    {"method":"*","path":"/login"},
    {"method":"GET","path":"/people"},
    {"method":"HEAD","path":"/people"},
    {"method":"GET","path":"/persons"},
    {"method":"HEAD","path":"/persons"},
    {"method":"GET","path":"/profile"},
    {"method":"HEAD","path":"/profile"},
    {"method":"GET","path":"/profile/{}","raw":"/profile/:id"},
    {"method":"HEAD","path":"/profile/{}","raw":"/profile/:id"},
    {"method":"GET","path":"/reports/{}","raw":"/reports/:id"},
    {"method":"HEAD","path":"/reports/{}","raw":"/reports/:id"},
    {"method":"GET","path":"/reports/latest"},
    {"method":"HEAD","path":"/reports/latest"},
    {"method":"DELETE","path":"/sessions/{}","raw":"/sessions/:id"},
    {"method":"PATCH","path":"/settings/{}","raw":"/settings/:key"},
    {"method":"GET","path":"/sign-in"},
    {"method":"HEAD","path":"/sign-in"},
    {"method":"GET","path":"/user/{}","raw":"/user/:id"},
    {"method":"HEAD","path":"/user/{}","raw":"/user/:id"},
    {"method":"GET","path":"/users"},
    {"method":"HEAD","path":"/users"},
    {"method":"POST","path":"/users"},
    {"method":"*","path":"/users/{}","raw":"/users/:id"},
    {"method":"DELETE","path":"/users/{}","raw":"/users/:id"},
    {"method":"PUT","path":"/users/{}","raw":"/users/:id"}
  ]
}
