{
  "framework": "micronaut",
  "version": "4.10.36",
  "routes": [
    {"method":"GET","path":"/"},
    {"method":"HEAD","path":"/"},
    {"method":"GET","path":"/beans"},
    {"method":"HEAD","path":"/beans"},
    {"method":"GET","path":"/books"},
    {"method":"HEAD","path":"/books"},
    {"method":"POST","path":"/books"},
    {"method":"DELETE","path":"/books/{}","raw":"/books/{id}"},
    {"method":"GET","path":"/books/{}","raw":"/books/{id}"},
    {"method":"HEAD","path":"/books/{}","raw":"/books/{id}"},
    {"method":"PATCH","path":"/books/{}","raw":"/books/{id}"},
    {"method":"PUT","path":"/books/{}","raw":"/books/{id}"},
    {"method":"GET","path":"/books/genre","raw":"/books/genre{/name:[a-zA-Z]+}"},
    {"method":"HEAD","path":"/books/genre","raw":"/books/genre{/name:[a-zA-Z]+}"},
    {"method":"GET","path":"/books/genre/{}","raw":"/books/genre{/name:[a-zA-Z]+}"},
    {"method":"HEAD","path":"/books/genre/{}","raw":"/books/genre{/name:[a-zA-Z]+}"},
    {"method":"GET","path":"/books/page","raw":"/books/page{?max,offset}"},
    {"method":"HEAD","path":"/books/page","raw":"/books/page{?max,offset}"},
    {"method":"GET","path":"/books/shelf/{}","raw":"/books/shelf/{code:2}"},
    {"method":"HEAD","path":"/books/shelf/{}","raw":"/books/shelf/{code:2}"},
    {"method":"GET","path":"/files/{**}","raw":"/files/{+path}"},
    {"method":"HEAD","path":"/files/{**}","raw":"/files/{+path}"},
    {"method":"GET","path":"/health"},
    {"method":"HEAD","path":"/health"},
    {"method":"GET","path":"/health/{}","raw":"/health/{selector}"},
    {"method":"HEAD","path":"/health/{}","raw":"/health/{selector}"},
    {"method":"GET","path":"/hello/{}","raw":"/hello/{name}"},
    {"method":"HEAD","path":"/hello/{}","raw":"/hello/{name}"},
    {"method":"GET","path":"/hello/person/{}","raw":"/hello/person/{name}"},
    {"method":"HEAD","path":"/hello/person/{}","raw":"/hello/person/{name}"},
    {"method":"GET","path":"/info"},
    {"method":"HEAD","path":"/info"},
    {"method":"GET","path":"/issues/{}","raw":"/issues/{number}"},
    {"method":"HEAD","path":"/issues/{}","raw":"/issues/{number}"},
    {"method":"GET","path":"/issues/default","raw":"/issues/default{/number}"},
    {"method":"HEAD","path":"/issues/default","raw":"/issues/default{/number}"},
    {"method":"GET","path":"/issues/default/{}","raw":"/issues/default{/number}"},
    {"method":"HEAD","path":"/issues/default/{}","raw":"/issues/default{/number}"},
    {"method":"GET","path":"/issues/issue/{}","raw":"/issues/issue/{number}"},
    {"method":"HEAD","path":"/issues/issue/{}","raw":"/issues/issue/{number}"},
    {"method":"GET","path":"/issues/show/{}","raw":"/issues/show/{number}"},
    {"method":"LOCK","path":"/locks/{}","raw":"/locks/{name}"},
    {"method":"POST","path":"/pets"},
    {"method":"GET","path":"/pets/{}","raw":"/pets/{slug}"},
    {"method":"HEAD","path":"/pets/{}","raw":"/pets/{slug}"},
    {"method":"HEAD","path":"/ping"},
    {"method":"POST","path":"/refresh"},
    {"method":"GET","path":"/routes"},
    {"method":"HEAD","path":"/routes"},
    {"method":"*","path":"/static/{**}","raw":"/static/**"},
    {"method":"GET","path":"/threaddump"},
    {"method":"HEAD","path":"/threaddump"},
    {"method":"TRACE","path":"/trace"}
  ]
}
