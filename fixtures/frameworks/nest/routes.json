{
  "framework": "nestjs",
  "version": "12.3.2",
  "routes": [
    {"method":"GET","path":"/api/dogs/count"},
    {"method":"GET","path":"/api/ping"},
    {"method":"GET","path":"/api/v1"},
    {"method":"GET","path":"/api/v1/admin"},
    {"method":"GET","path":"/api/v1/admin/dashboard/widgets"},
    {"method":"DELETE","path":"/api/v1/admin/dashboard/widgets/{}","raw":"/api/v1/admin/dashboard/widgets/:id"},
    {"method":"GET","path":"/api/v1/admin/dashboard/widgets/{}","raw":"/api/v1/admin/dashboard/widgets/:id"},
    {"method":"GET","path":"/api/v1/admin/metrics"},
    {"method":"GET","path":"/api/v1/cats"},
    {"method":"POST","path":"/api/v1/cats"},
    {"method":"DELETE","path":"/api/v1/cats/{}","raw":"/api/v1/cats/:id"},
    {"method":"GET","path":"/api/v1/cats/{}","raw":"/api/v1/cats/:id"},
    {"method":"PATCH","path":"/api/v1/cats/{}","raw":"/api/v1/cats/:id"},
    {"method":"PUT","path":"/api/v1/cats/{}","raw":"/api/v1/cats/:id"},
    {"method":"GET","path":"/api/v1/cats/{}/kittens/{}","raw":"/api/v1/cats/:id/kittens/:kittenId"},
    {"method":"GET","path":"/api/v1/cats/abcd","raw":"/api/v1/cats/abcd/"},
    {"method":"GET","path":"/api/v1/cats/abcd/{**}","raw":"/api/v1/cats/abcd/*path"},
    {"method":"GET","path":"/api/v1/cats/files/{**}","raw":"/api/v1/cats/files/*filepath"},
    {"method":"*","path":"/api/v1/cats/legacy"},
    {"method":"QUERY","path":"/api/v1/cats/search"},
    {"method":"GET","path":"/api/v1/dogs"},
    {"method":"POST","path":"/api/v1/health"},
    {"method":"GET","path":"/api/v2/cats"},
    {"method":"GET","path":"/api/v2/dogs"},
    {"method":"GET","path":"/api/v3/admin/metrics/cpu"},
    {"method":"GET","path":"/api/v3/dogs/trips/{}-{}","raw":"/api/v3/dogs/trips/:from-:to"},
    {"method":"GET","path":"/v1/about"},
    {"method":"GET","path":"/v1/health"}
  ]
}
