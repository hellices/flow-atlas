{
  "framework": "astro",
  "version": "7.4.4",
  "routes": [
    {"method":"*","path":"/"},
    {"method":"*","path":"/_astro/{**}","raw":"dist/client/_astro/*"},
    {"method":"GET","path":"/_image"},
    {"method":"*","path":"/{}/{}/info","raw":"/[lang]/[version]/info"},
    {"method":"*","path":"/about"},
    {"method":"GET","path":"/api/{}.json","raw":"/api/[id].json"},
    {"method":"*","path":"/api/echo"},
    {"method":"GET","path":"/api/files","raw":"/api/files/[...path]"},
    {"method":"GET","path":"/api/files/{**}","raw":"/api/files/[...path]"},
    {"method":"GET","path":"/api/items"},
    {"method":"POST","path":"/api/items"},
    {"method":"DELETE","path":"/api/items/{}","raw":"/api/items/[id]"},
    {"method":"GET","path":"/api/items/{}","raw":"/api/items/[id]"},
    {"method":"PATCH","path":"/api/items/{}","raw":"/api/items/[id]"},
    {"method":"PUT","path":"/api/items/{}","raw":"/api/items/[id]"},
    {"method":"*","path":"/api/session"},
    {"method":"*","path":"/articles","raw":"/articles/[...slug]"},
    {"method":"*","path":"/articles/{**}","raw":"/articles/[...slug]"},
    {"method":"*","path":"/blog"},
    {"method":"*","path":"/blog/{}","raw":"/blog/[slug]"},
    {"method":"*","path":"/builtwith.json"},
    {"method":"*","path":"/contact"},
    {"method":"*","path":"/docs","raw":"/docs/[...slug]"},
    {"method":"*","path":"/docs/{**}","raw":"/docs/[...slug]"},
    {"method":"*","path":"/dogs/clifford","raw":"/dogs/[dog]"},
    {"method":"*","path":"/dogs/rover","raw":"/dogs/[dog]"},
    {"method":"*","path":"/dogs/spot","raw":"/dogs/[dog]"},
    {"method":"*","path":"/favicon.svg","raw":"public/favicon.svg"},
    {"method":"*","path":"/news"},
    {"method":"*","path":"/old-about"},
    {"method":"*","path":"/posts/first"},
    {"method":"*","path":"/releases/{}-{}","raw":"/releases/[lang]-[version]"},
    {"method":"*","path":"/repos/{}/{}/tree/{}","raw":"/repos/[org]/[repo]/tree/[branch]/[...file]"},
    {"method":"*","path":"/repos/{}/{}/tree/{}/{**}","raw":"/repos/[org]/[repo]/tree/[branch]/[...file]"},
    {"method":"*","path":"/robots.txt","raw":"public/robots.txt"},
    {"method":"*","path":"/sequences","raw":"/sequences/[...path]"},
    {"method":"*","path":"/sequences/four","raw":"/sequences/[...path]"},
    {"method":"*","path":"/sequences/one/two/three","raw":"/sequences/[...path]"},
    {"method":"GET","path":"/sitemap.xml"}
  ]
}
