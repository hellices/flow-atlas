{
  "framework": "slim",
  "version": "4.15.3",
  "routes": [
    {"method":"GET","path":"/"},
    {"method":"OPTIONS","path":"/{**}","raw":"/{routes:.+}"},
    {"method":"GET","path":"/accounts","raw":"/accounts[/{id}]"},
    {"method":"GET","path":"/accounts/{}","raw":"/accounts[/{id}]"},
    {"method":"GET","path":"/api/status"},
    {"method":"GET","path":"/api/v1/tags"},
    {"method":"POST","path":"/api/v1/tags"},
    {"method":"GET","path":"/api/v1/tags/{}","raw":"/api/v1/tags/{tag}"},
    {"method":"GET","path":"/archive","raw":"/archive[/{params:.*}]"},
    {"method":"GET","path":"/archive/{**}","raw":"/archive[/{params:.*}]"},
    {"method":"GET","path":"/billing"},
    {"method":"GET","path":"/books"},
    {"method":"POST","path":"/books"},
    {"method":"DELETE","path":"/books/{}","raw":"/books/{id}"},
    {"method":"GET","path":"/books/{}","raw":"/books/{id}"},
    {"method":"OPTIONS","path":"/books/{}","raw":"/books/{id}"},
    {"method":"PATCH","path":"/books/{}","raw":"/books/{id}"},
    {"method":"PUT","path":"/books/{}","raw":"/books/{id}"},
    {"method":"GET","path":"/contact"},
    {"method":"GET","path":"/files/{**}","raw":"/files/{path:.+}"},
    {"method":"GET","path":"/flights/{}-{}","raw":"/flights/{from}-{to}"},
    {"method":"GET","path":"/forms"},
    {"method":"POST","path":"/forms"},
    {"method":"GET","path":"/hello/{}","raw":"/hello/{name}"},
    {"method":"GET","path":"/invoice/{}","raw":"/invoice/{id:[0-9]+}"},
    {"method":"*","path":"/items","raw":"/items[/{id}]"},
    {"method":"*","path":"/items/{}","raw":"/items[/{id}]"},
    {"method":"GET","path":"/library"},
    {"method":"GET","path":"/members/{}","raw":"/members/{id:[0-9]+}"},
    {"method":"GET","path":"/news","raw":"/news[/{year}[/{month}]]"},
    {"method":"GET","path":"/news/{}","raw":"/news[/{year}[/{month}]]"},
    {"method":"GET","path":"/news/{}/{}","raw":"/news[/{year}[/{month}]]"},
    {"method":"POST","path":"/orders"},
    {"method":"GET","path":"/posts/{}.{}","raw":"/posts/{slug:[a-z0-9-]+}.{format:json|xml}"},
    {"method":"DELETE","path":"/users/{}","raw":"/users/{id:[0-9]+}"},
    {"method":"GET","path":"/users/{}","raw":"/users/{id:[0-9]+}"},
    {"method":"PATCH","path":"/users/{}","raw":"/users/{id:[0-9]+}"},
    {"method":"PUT","path":"/users/{}","raw":"/users/{id:[0-9]+}"},
    {"method":"GET","path":"/users/{}/reset-password","raw":"/users/{id:[0-9]+}/reset-password"}
  ]
}
