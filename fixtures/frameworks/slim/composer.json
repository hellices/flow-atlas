{
    "name": "flow-atlas/slim-routes",
    "description": "A small Slim application exercising the routing guide, for flow-atlas's framework fixtures.",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "slim/psr7": "^1.8",
        "slim/slim": "^4.15"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
