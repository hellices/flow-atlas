{
  "framework": "fastify",
  "version": "5.12.7",
  "routes": [
    {"method":"GET","path":"/"},
    {"method":"HEAD","path":"/"},
    {"method":"*","path":"/any"},
    {"method":"GET","path":"/api"},
    {"method":"HEAD","path":"/api"},
    {"method":"GET","path":"/api/admin/dashboard"},
    {"method":"HEAD","path":"/api/admin/dashboard"},
    {"method":"PATCH","path":"/api/admin/settings/{}","raw":"/api/admin/settings/:key"},
    {"method":"GET","path":"/example","raw":"/example/*"},
    {"method":"HEAD","path":"/example","raw":"/example/*"},
    {"method":"GET","path":"/example/{}","raw":"/example/:userId"},
    {"method":"HEAD","path":"/example/{}","raw":"/example/:userId"},
    {"method":"GET","path":"/example/{}.png","raw":"/example/:file(^\\d+).png"},
    {"method":"HEAD","path":"/example/{}.png","raw":"/example/:file(^\\d+).png"},
    {"method":"GET","path":"/example/{}/{}","raw":"/example/:userId/:secretToken"},
    {"method":"HEAD","path":"/example/{}/{}","raw":"/example/:userId/:secretToken"},
    {"method":"GET","path":"/example/{**}","raw":"/example/*"},
    {"method":"HEAD","path":"/example/{**}","raw":"/example/*"},
    {"method":"GET","path":"/example/at/{}h{}m","raw":"/example/at/:hour(^\\d{2})h:minute(^\\d{2})m"},
    {"method":"HEAD","path":"/example/at/{}h{}m","raw":"/example/at/:hour(^\\d{2})h:minute(^\\d{2})m"},
    {"method":"GET","path":"/example/lang/{}","raw":"/example/lang/:code(^[a-z]+)"},
    {"method":"HEAD","path":"/example/lang/{}","raw":"/example/lang/:code(^[a-z]+)"},
    {"method":"GET","path":"/example/near/{}-{}/radius/{}","raw":"/example/near/:lat-:lng/radius/:r"},
    {"method":"HEAD","path":"/example/near/{}-{}/radius/{}","raw":"/example/near/:lat-:lng/radius/:r"},
    {"method":"GET","path":"/example/posts"},
    {"method":"HEAD","path":"/example/posts"},
    {"method":"GET","path":"/example/posts/{}","raw":"/example/posts/:id"},
    {"method":"HEAD","path":"/example/posts/{}","raw":"/example/posts/:id"},
    {"method":"GET","path":"/hello"},
    {"method":"HEAD","path":"/hello"},
    {"method":"POST","path":"/items"},
    {"method":"PUT","path":"/items"},
    {"method":"POST","path":"/name:verb","raw":"/name::verb"},
    {"method":"GET","path":"/public","raw":"/public/*"},
    {"method":"HEAD","path":"/public","raw":"/public/*"},
    {"method":"GET","path":"/public/{**}","raw":"/public/*"},
    {"method":"HEAD","path":"/public/{**}","raw":"/public/*"},
    {"method":"QUERY","path":"/search"},
    {"method":"GET","path":"/status"},
    {"method":"HEAD","path":"/status"},
    {"method":"GET","path":"/v1/user"},
    {"method":"HEAD","path":"/v1/user"},
    {"method":"GET","path":"/v2/user"},
    {"method":"HEAD","path":"/v2/user"},
    {"method":"DELETE","path":"/v2/user/{}","raw":"/v2/user/:id"},
    {"method":"GET","path":"/versioned"},
    {"method":"HEAD","path":"/versioned"}
  ]
}
