{
  "framework": "express",
  "version": "5.3.0",
  "routes": [
    {"method":"GET","path":"/"},
    {"method":"POST","path":"/"},
    {"method":"GET","path":"/about"},
    {"method":"GET","path":"/about/{}","raw":"/about/:section"},
    {"method":"DELETE","path":"/admin/cache"},
    {"method":"GET","path":"/admin/dashboard"},
    {"method":"GET","path":"/book"},
    {"method":"POST","path":"/book"},
    {"method":"PUT","path":"/book"},
    {"method":"GET","path":"/example/b"},
    {"method":"GET","path":"/example/e"},
    {"method":"GET","path":"/faq"},
    {"method":"GET","path":"/files/{**}","raw":"/files/*filepath"},
    {"method":"GET","path":"/flights/{}-{}","raw":"/flights/:from-:to"},
    {"method":"GET","path":"/help"},
    {"method":"GET","path":"/home"},
    {"method":"GET","path":"/plantae/{}.{}","raw":"/plantae/:genus.:species"},
    {"method":"*","path":"/secret"},
    {"method":"GET","path":"/users","raw":"/users/"},
    {"method":"POST","path":"/users","raw":"/users/"},
    {"method":"DELETE","path":"/users/{}","raw":"/users/:id"},
    {"method":"GET","path":"/users/{}","raw":"/users/:id"},
    {"method":"PUT","path":"/users/{}","raw":"/users/:id"},
    {"method":"GET","path":"/users/{}/books/{}","raw":"/users/:userId/books/:bookId"},
    {"method":"GET","path":"/users/{}/posts","raw":"/users/:userId/posts/"},
    {"method":"GET","path":"/users/{}/posts/{}","raw":"/users/:userId/posts/:postId"},
    {"method":"GET","path":"/users/me"}
  ]
}
