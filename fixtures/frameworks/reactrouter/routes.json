{
  "framework": "react-router",
  "version": "8.5.1",
  "routes": [
    {"method":"GET","path":"/"},
    {"method":"*","path":"/__manifest","raw":"routeDiscovery.manifestPath"},
    {"method":"GET","path":"/{}/categories","raw":"/:lang?/categories"},
    {"method":"GET","path":"/{}/shop","raw":"/:lang?/shop"},
    {"method":"GET","path":"/about"},
    {"method":"DELETE","path":"/api/items"},
    {"method":"GET","path":"/api/items"},
    {"method":"PATCH","path":"/api/items"},
    {"method":"POST","path":"/api/items"},
    {"method":"PUT","path":"/api/items"},
    {"method":"DELETE","path":"/api/notes/{}","raw":"/api/notes/:id"},
    {"method":"GET","path":"/api/notes/{}","raw":"/api/notes/:id"},
    {"method":"PATCH","path":"/api/notes/{}","raw":"/api/notes/:id"},
    {"method":"POST","path":"/api/notes/{}","raw":"/api/notes/:id"},
    {"method":"PUT","path":"/api/notes/{}","raw":"/api/notes/:id"},
    {"method":"DELETE","path":"/api/webhook"},
    {"method":"PATCH","path":"/api/webhook"},
    {"method":"POST","path":"/api/webhook"},
    {"method":"PUT","path":"/api/webhook"},
    {"method":"GET","path":"/assets/{**}","raw":"build/client/assets/*"},
    {"method":"GET","path":"/blog"},
    {"method":"GET","path":"/blog/{}","raw":"/blog/:slug"},
    {"method":"GET","path":"/blog/archive"},
    {"method":"GET","path":"/c/{}/p/{}","raw":"/c/:categoryId/p/:productId"},
    {"method":"GET","path":"/categories","raw":"/:lang?/categories"},
    {"method":"GET","path":"/concerts"},
    {"method":"GET","path":"/concerts/{}","raw":"/concerts/:city"},
    {"method":"GET","path":"/concerts/trending"},
    {"method":"DELETE","path":"/contact"},
    {"method":"GET","path":"/contact"},
    {"method":"PATCH","path":"/contact"},
    {"method":"POST","path":"/contact"},
    {"method":"PUT","path":"/contact"},
    {"method":"GET","path":"/dashboard"},
    {"method":"DELETE","path":"/dashboard/settings"},
    {"method":"GET","path":"/dashboard/settings"},
    {"method":"PATCH","path":"/dashboard/settings"},
    {"method":"POST","path":"/dashboard/settings"},
    {"method":"PUT","path":"/dashboard/settings"},
    {"method":"GET","path":"/docs","raw":"/docs/*"},
    {"method":"GET","path":"/docs/{**}","raw":"/docs/*"},
    {"method":"GET","path":"/files","raw":"/files/*"},
    {"method":"GET","path":"/files/{**}","raw":"/files/*"},
    {"method":"GET","path":"/invoices/{}","raw":"/invoices/:id"},
    {"method":"DELETE","path":"/login"},
    {"method":"GET","path":"/login"},
    {"method":"PATCH","path":"/login"},
    {"method":"POST","path":"/login"},
    {"method":"PUT","path":"/login"},
    {"method":"GET","path":"/logo.svg","raw":"public/logo.svg"},
    {"method":"GET","path":"/pricing"},
    {"method":"DELETE","path":"/register"},
    {"method":"GET","path":"/register"},
    {"method":"PATCH","path":"/register"},
    {"method":"POST","path":"/register"},
    {"method":"PUT","path":"/register"},
    {"method":"GET","path":"/reports/pdf/{}","raw":"/reports/pdf/:id"},
    {"method":"GET","path":"/robots.txt","raw":"public/robots.txt"},
    {"method":"GET","path":"/shop","raw":"/:lang?/shop"},
    {"method":"GET","path":"/sitemap.xml"},
    {"method":"GET","path":"/users/{}","raw":"/users/:userId/edit?"},
    {"method":"GET","path":"/users/{}/edit","raw":"/users/:userId/edit?"}
  ]
}
