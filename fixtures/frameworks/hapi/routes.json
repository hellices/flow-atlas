{
  "framework": "hapi",
  "version": "21.4.12",
  "routes": [
    {"method":"*","path":"/","raw":"/{any*}"},
    {"method":"GET","path":"/"},
    {"method":"POST","path":"/"},
    {"method":"PUT","path":"/"},
    {"method":"*","path":"/{**}","raw":"/{any*}"},
    {"method":"DELETE","path":"/admin/cache","raw":"/admin/cache/{key?}"},
    {"method":"DELETE","path":"/admin/cache/{}","raw":"/admin/cache/{key?}"},
    {"method":"GET","path":"/admin/dashboard"},
    {"method":"GET","path":"/files","raw":"/files/{path*}"},
    {"method":"GET","path":"/files/{**}","raw":"/files/{path*}"},
    {"method":"GET","path":"/greet","raw":"/greet/{user?}"},
    {"method":"GET","path":"/greet/{}","raw":"/greet/{user?}"},
    {"method":"GET","path":"/health"},
    {"method":"GET","path":"/hello/{}","raw":"/hello/{user}"},
    {"method":"GET","path":"/images/{}.jpg","raw":"/images/{filename}.jpg"},
    {"method":"GET","path":"/names/{}/{}","raw":"/names/{user*2}"},
    {"method":"GET","path":"/reports/q{}/summary","raw":"/reports/q{quarter?}/summary"},
    {"method":"GET","path":"/reports/q/summary","raw":"/reports/q{quarter?}/summary"},
    {"method":"POST","path":"/signup"},
    {"method":"GET","path":"/users"},
    {"method":"POST","path":"/users"},
    {"method":"DELETE","path":"/users/{}","raw":"/users/{id}"},
    {"method":"GET","path":"/users/{}","raw":"/users/{id}"},
    {"method":"PATCH","path":"/users/{}","raw":"/users/{id}"},
    {"method":"PUT","path":"/users/{}","raw":"/users/{id}"},
    {"method":"GET","path":"/v1/products"},
    {"method":"POST","path":"/v1/products"},
    {"method":"GET","path":"/v1/products/{}","raw":"/v1/products/{id}"},
    {"method":"GET","path":"/v1/reviews"},
    {"method":"GET","path":"/v1/reviews/{}","raw":"/v1/reviews/{reviewId}"}
  ]
}
