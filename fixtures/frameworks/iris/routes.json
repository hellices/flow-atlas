{
  "framework": "iris",
  "version": "12.2.11",
  "routes": [
    {"method":"GET","path":"/"},
    {"method":"GET","path":"/accounts/{}/profile","raw":"/accounts/{id:uint64}/profile"},
    {"method":"GET","path":"/accounts/messages/{}","raw":"/accounts/messages/{id:uint64}"},
    {"method":"*","path":"/anything"},
    {"method":"GET","path":"/api/health"},
    {"method":"GET","path":"/api/v1/users"},
    {"method":"POST","path":"/api/v1/users"},
    {"method":"DELETE","path":"/api/v1/users/{}","raw":"/api/v1/users/{id:uint64}"},
    {"method":"GET","path":"/api/v1/users/{}","raw":"/api/v1/users/{id:uint64}"},
    {"method":"PUT","path":"/api/v1/users/{}","raw":"/api/v1/users/{id:uint64}"},
    {"method":"GET","path":"/api/v2/users/{}","raw":"/api/v2/users/{id:uuid}"},
    {"method":"GET","path":"/assets-wild/{**}","raw":"/assets-wild/{asset:path}"},
    {"method":"GET","path":"/books"},
    {"method":"POST","path":"/books"},
    {"method":"DELETE","path":"/books/{}","raw":"/books/{param1:int64}"},
    {"method":"GET","path":"/books/{}","raw":"/books/{param1:int64}"},
    {"method":"PUT","path":"/books/{}","raw":"/books/{param1:int64}"},
    {"method":"GET","path":"/books/author/{}","raw":"/books/author/{param1:string}"},
    {"method":"GET","path":"/books/authors"},
    {"method":"GET","path":"/books/files/{**}","raw":"/books/files/{param1:path}"},
    {"method":"GET","path":"/books/something/{}","raw":"/books/something/{id:int64}"},
    {"method":"GET","path":"/contact"},
    {"method":"GET","path":"/favicon.ico"},
    {"method":"HEAD","path":"/favicon.ico"},
    {"method":"DELETE","path":"/form"},
    {"method":"PATCH","path":"/form"},
    {"method":"POST","path":"/form"},
    {"method":"PUT","path":"/form"},
    {"method":"HEAD","path":"/head"},
    {"method":"GET","path":"/limitchar/{}","raw":"/limitchar/{name:string range(1,200) else 400}"},
    {"method":"OPTIONS","path":"/preflight"},
    {"method":"GET","path":"/profile/{}","raw":"/profile/{username:string}"},
    {"method":"GET","path":"/profile/me"},
    {"method":"GET","path":"/static"},
    {"method":"HEAD","path":"/static"},
    {"method":"GET","path":"/static/{**}","raw":"/static/{file:path}"},
    {"method":"HEAD","path":"/static/{**}","raw":"/static/{file:path}"},
    {"method":"GET","path":"/tours/{}","raw":"/tours/{alias:string regexp(^[a-z0-9]{1,10}[.]xml$)}"},
    {"method":"GET","path":"/tours/{}","raw":"/tours/{alias:string regexp(^[a-z0-9]{1,10}$)}"},
    {"method":"TRACE","path":"/trace"},
    {"method":"GET","path":"/u/{}","raw":"/u/{firstname:alphabetical}"},
    {"method":"GET","path":"/u/{}","raw":"/u/{id:int}"},
    {"method":"GET","path":"/u/{}","raw":"/u/{uid:uint}"},
    {"method":"GET","path":"/u/{}","raw":"/u/{username:string}"},
    {"method":"DELETE","path":"/user/{}","raw":"/user/{userid:int min(1)}"},
    {"method":"GET","path":"/user/{}","raw":"/user/{userid:int min(1)}"},
    {"method":"POST","path":"/user/{}/{**}","raw":"/user/{name:string}/{action:path}"},
    {"method":"GET","path":"/users/{}/profile","raw":"/users/{id:uint64}/profile"},
    {"method":"GET","path":"/users/messages/{}","raw":"/users/messages/{id:uint64}"}
  ]
}
