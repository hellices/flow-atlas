{
  "framework": "spring-boot",
  "version": "4.1.2",
  "routes": [
    {"method":"GET","path":"/"},
    {"method":"HEAD","path":"/"},
    {"method":"GET","path":"/{**}","raw":"/**"},
    {"method":"HEAD","path":"/{**}","raw":"/**"},
    {"method":"GET","path":"/actuator"},
    {"method":"GET","path":"/actuator/health"},
    {"method":"GET","path":"/actuator/health/{**}","raw":"/actuator/health/**"},
    {"method":"GET","path":"/api/account/{}","raw":"/api/account/{id}"},
    {"method":"GET","path":"/api/library/{}-{}{}","raw":"/api/library/{name:[a-z-]+}-{version:\\d\\.\\d\\.\\d}{ext:\\.[a-z]+}"},
    {"method":"GET","path":"/api/library/archive"},
    {"method":"GET","path":"/api/library/archive/{**}","raw":"/api/library/archive/**"},
    {"method":"GET","path":"/api/library/pages/t{}st.html","raw":"/api/library/pages/t?st.html"},
    {"method":"GET","path":"/api/library/projects/{}/versions","raw":"/api/library/projects/{project:[a-z]+}/versions"},
    {"method":"GET","path":"/api/library/resources"},
    {"method":"GET","path":"/api/library/resources/{}.png","raw":"/api/library/resources/*.png"},
    {"method":"GET","path":"/api/library/resources/{**}","raw":"/api/library/resources/{*file}"},
    {"method":"POST","path":"/api/members"},
    {"method":"GET","path":"/api/members/{}","raw":"/api/members/{id}"},
    {"method":"GET","path":"/api/notes"},
    {"method":"POST","path":"/api/notes"},
    {"method":"DELETE","path":"/api/notes/{}","raw":"/api/notes/{id}"},
    {"method":"GET","path":"/api/notes/{}","raw":"/api/notes/{id}"},
    {"method":"POST","path":"/api/persons"},
    {"method":"DELETE","path":"/api/persons/{}","raw":"/api/persons/{id}"},
    {"method":"GET","path":"/api/persons/{}","raw":"/api/persons/{id}"},
    {"method":"PATCH","path":"/api/persons/{}","raw":"/api/persons/{id}"},
    {"method":"PUT","path":"/api/persons/{}","raw":"/api/persons/{id}"},
    {"method":"POST","path":"/api/pets"},
    {"method":"GET","path":"/api/pets/{}","raw":"/api/pets/{petId}"},
    {"method":"*","path":"/error"},
    {"method":"GET","path":"/faq"},
    {"method":"POST","path":"/faq"},
    {"method":"GET","path":"/files/{**}","raw":"/files/**"},
    {"method":"HEAD","path":"/files/{**}","raw":"/files/**"},
    {"method":"GET","path":"/hello-world"},
    {"method":"GET","path":"/help"},
    {"method":"POST","path":"/help"},
    {"method":"GET","path":"/memos"},
    {"method":"GET","path":"/memos/{}","raw":"/memos/{id}"},
    {"method":"GET","path":"/memos/{**}","raw":"/memos/**"},
    {"method":"GET","path":"/owners/{}/pets/{}","raw":"/owners/{ownerId}/pets/{petId}"},
    {"method":"GET","path":"/people"},
    {"method":"POST","path":"/people"},
    {"method":"GET","path":"/people/{}","raw":"/people/{id}"},
    {"method":"*","path":"/ping"},
    {"method":"GET","path":"/teams"},
    {"method":"POST","path":"/teams"},
    {"method":"DELETE","path":"/teams/{}","raw":"/teams/{id}"},
    {"method":"GET","path":"/teams/{}","raw":"/teams/{id}"},
    {"method":"PUT","path":"/teams/{}","raw":"/teams/{id}"},
    {"method":"GET","path":"/teams/{**}","raw":"/teams/**"},
    {"method":"POST","path":"/teams/{**}","raw":"/teams/**"},
    {"method":"GET","path":"/user/{}","raw":"/user/{id}"},
    {"method":"GET","path":"/webjars"},
    {"method":"HEAD","path":"/webjars"},
    {"method":"GET","path":"/webjars/{**}","raw":"/webjars/**"},
    {"method":"HEAD","path":"/webjars/{**}","raw":"/webjars/**"}
  ]
}
