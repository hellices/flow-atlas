{
  "framework": "beego",
  "version": "2.3.10",
  "routes": [
    {"method":"GET","path":"/"},
    {"method":"TRACE","path":"/"},
    {"method":"GET","path":"/all/{}","raw":"/all/:key"},
    {"method":"POST","path":"/all/{}","raw":"/all/:key"},
    {"method":"*","path":"/any"},
    {"method":"*","path":"/api/status/ping","raw":"api/status/ping/*"},
    {"method":"*","path":"/api/status/ping/{**}","raw":"api/status/ping/*"},
    {"method":"GET","path":"/api/user/{}","raw":"api/user/:id"},
    {"method":"DELETE","path":"/api/user/delete","raw":"api/user/delete"},
    {"method":"*","path":"/api/user/home","raw":"api/user/home"},
    {"method":"PATCH","path":"/api/user/patch","raw":"api/user/patch"},
    {"method":"PUT","path":"/api/user/put","raw":"api/user/put"},
    {"method":"POST","path":"/api/user/update","raw":"api/user/update"},
    {"method":"GET","path":"/assets/{**}","raw":"/assets -> static"},
    {"method":"HEAD","path":"/assets/{**}","raw":"/assets -> static"},
    {"method":"DELETE","path":"/echo"},
    {"method":"PUT","path":"/echo"},
    {"method":"*","path":"/echo/any"},
    {"method":"GET","path":"/getOrPost"},
    {"method":"POST","path":"/getOrPost"},
    {"method":"GET","path":"/health"},
    {"method":"GET","path":"/hello"},
    {"method":"*","path":"/mounted"},
    {"method":"*","path":"/mounted/{**}","raw":"/mounted"},
    {"method":"POST","path":"/post/hello"},
    {"method":"*","path":"/report/detail","raw":"/report/detail/*"},
    {"method":"*","path":"/report/detail/{**}","raw":"/report/detail/*"},
    {"method":"*","path":"/report/summary","raw":"/report/summary/*"},
    {"method":"*","path":"/report/summary/{**}","raw":"/report/summary/*"},
    {"method":"GET","path":"/rules/{}/profile","raw":"/rules/:username/profile"},
    {"method":"GET","path":"/rules/cms_{}.html","raw":"/rules/cms_:id([0-9]+).html"},
    {"method":"GET","path":"/rules/int/{}","raw":"/rules/int/:id:int"},
    {"method":"POST","path":"/rules/name","raw":"/rules/name/*"},
    {"method":"POST","path":"/rules/name/{**}","raw":"/rules/name/*"},
    {"method":"GET","path":"/rules/numeric/{}","raw":"/rules/numeric/:id([0-9]+)"},
    {"method":"GET","path":"/rules/optional","raw":"/rules/optional/?:id"},
    {"method":"GET","path":"/rules/optional/{}","raw":"/rules/optional/?:id"},
    {"method":"GET","path":"/rules/word/{}","raw":"/rules/word/:hi:string"},
    {"method":"GET","path":"/static/{**}","raw":"/static -> static"},
    {"method":"HEAD","path":"/static/{**}","raw":"/static -> static"},
    {"method":"GET","path":"/staticblock/{}","raw":"/staticblock/:key"},
    {"method":"POST","path":"/update"},
    {"method":"GET","path":"/user"},
    {"method":"POST","path":"/user"},
    {"method":"TRACE","path":"/user"},
    {"method":"GET","path":"/v1/admin/user"},
    {"method":"POST","path":"/v1/admin/user"},
    {"method":"TRACE","path":"/v1/admin/user"},
    {"method":"GET","path":"/v1/health"},
    {"method":"GET","path":"/v1/home"},
    {"method":"GET","path":"/v1/object","raw":"/v1/object/"},
    {"method":"POST","path":"/v1/object","raw":"/v1/object/"},
    {"method":"DELETE","path":"/v1/object/{}","raw":"/v1/object/:objectId"},
    {"method":"GET","path":"/v1/object/{}","raw":"/v1/object/:objectId"},
    {"method":"PUT","path":"/v1/object/{}","raw":"/v1/object/:objectId"},
    {"method":"GET","path":"/v1/user"},
    {"method":"POST","path":"/v1/user"},
    {"method":"TRACE","path":"/v1/user"}
  ]
}
