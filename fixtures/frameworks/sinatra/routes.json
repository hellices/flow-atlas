{
  "framework": "sinatra",
  "version": "4.2.1",
  "routes": [
    {"method":"GET","path":"/"},
    {"method":"HEAD","path":"/"},
    {"method":"GET","path":"/admin","raw":"/admin/"},
    {"method":"HEAD","path":"/admin","raw":"/admin/"},
    {"method":"DELETE","path":"/admin/cache"},
    {"method":"GET","path":"/admin/reports/{}","raw":"/admin/reports/:id"},
    {"method":"HEAD","path":"/admin/reports/{}","raw":"/admin/reports/:id"},
    {"method":"GET","path":"/api","raw":"/api/"},
    {"method":"HEAD","path":"/api","raw":"/api/"},
    {"method":"GET","path":"/api/v1/items"},
    {"method":"HEAD","path":"/api/v1/items"},
    {"method":"POST","path":"/api/v1/items"},
    {"method":"GET","path":"/api/v1/items/{}","raw":"/api/v1/items/{id}"},
    {"method":"HEAD","path":"/api/v1/items/{}","raw":"/api/v1/items/{id}"},
    {"method":"GET","path":"/api/v1/users/{}/orders","raw":"/api/v1/users/{user_id}/orders"},
    {"method":"HEAD","path":"/api/v1/users/{}/orders","raw":"/api/v1/users/{user_id}/orders"},
    {"method":"GET","path":"/api/v2/items/{}","raw":"/api/v2/items/{id}.?{format}?"},
    {"method":"HEAD","path":"/api/v2/items/{}","raw":"/api/v2/items/{id}.?{format}?"},
    {"method":"GET","path":"/api/v2/items/{}.","raw":"/api/v2/items/{id}.?{format}?"},
    {"method":"HEAD","path":"/api/v2/items/{}.","raw":"/api/v2/items/{id}.?{format}?"},
    {"method":"GET","path":"/api/v2/items/{}.{}","raw":"/api/v2/items/{id}.?{format}?"},
    {"method":"HEAD","path":"/api/v2/items/{}.{}","raw":"/api/v2/items/{id}.?{format}?"},
    {"method":"GET","path":"/contact"},
    {"method":"POST","path":"/contact"},
    {"method":"GET","path":"/faq"},
    {"method":"HEAD","path":"/faq"},
    {"method":"GET","path":"/files","raw":"/files/*"},
    {"method":"HEAD","path":"/files","raw":"/files/*"},
    {"method":"GET","path":"/files/{**}","raw":"/files/*"},
    {"method":"HEAD","path":"/files/{**}","raw":"/files/*"},
    {"method":"GET","path":"/flights/{}-{}","raw":"/flights/:from-:to"},
    {"method":"HEAD","path":"/flights/{}-{}","raw":"/flights/:from-:to"},
    {"method":"GET","path":"/hello/{}","raw":"/hello/:name"},
    {"method":"HEAD","path":"/hello/{}","raw":"/hello/:name"},
    {"method":"GET","path":"/help"},
    {"method":"HEAD","path":"/help"},
    {"method":"OPTIONS","path":"/items"},
    {"method":"POST","path":"/items"},
    {"method":"DELETE","path":"/items/{}","raw":"/items/:id"},
    {"method":"PATCH","path":"/items/{}","raw":"/items/:id"},
    {"method":"PUT","path":"/items/{}","raw":"/items/:id"},
    {"method":"GET","path":"/posts","raw":"/posts/:format?"},
    {"method":"HEAD","path":"/posts","raw":"/posts/:format?"},
    {"method":"GET","path":"/posts/{}","raw":"/posts/:format?"},
    {"method":"HEAD","path":"/posts/{}","raw":"/posts/:format?"},
    {"method":"GET","path":"/robots.txt","raw":"public/robots.txt"},
    {"method":"HEAD","path":"/robots.txt","raw":"public/robots.txt"}
  ]
}
