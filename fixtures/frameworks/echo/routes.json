{
  "framework": "echo",
  "version": "5.4.4",
  "routes": [
    {"method":"GET","path":"/"},
    {"method":"GET","path":"/{**}","raw":"/*"},
    {"method":"GET","path":"/admin/metrics"},
    {"method":"GET","path":"/admin/users"},
    {"method":"GET","path":"/api/v1/health"},
    {"method":"GET","path":"/api/v1/posts"},
    {"method":"POST","path":"/api/v1/posts"},
    {"method":"GET","path":"/api/v1/posts/{}","raw":"/api/v1/posts/:id"},
    {"method":"PATCH","path":"/api/v1/posts/{}","raw":"/api/v1/posts/:id"},
    {"method":"PUT","path":"/api/v1/posts/{}","raw":"/api/v1/posts/:id"},
    {"method":"*","path":"/api/v1/posts/{}/comments","raw":"/api/v1/posts/:id/comments"},
    {"method":"GET","path":"/downloads/file.{}","raw":"/downloads/file.:ext"},
    {"method":"GET","path":"/downloads/file.{}/{**}","raw":"/downloads/file.:ext"},
    {"method":"GET","path":"/favicon.ico"},
    {"method":"GET","path":"/files","raw":"/files/*"},
    {"method":"GET","path":"/files/{**}","raw":"/files/*"},
    {"method":"GET","path":"/form"},
    {"method":"POST","path":"/form"},
    {"method":"GET","path":"/images","raw":"/images/*"},
    {"method":"GET","path":"/images/{**}","raw":"/images/*"},
    {"method":"*","path":"/ping"},
    {"method":"GET","path":"/ping"},
    {"method":"GET","path":"/releases/v{}/notes","raw":"/releases/v:version/notes"},
    {"method":"GET","path":"/users","raw":"/users/*"},
    {"method":"POST","path":"/users"},
    {"method":"DELETE","path":"/users/{}","raw":"/users/:id"},
    {"method":"GET","path":"/users/{}","raw":"/users/:id"},
    {"method":"PUT","path":"/users/{}","raw":"/users/:id"},
    {"method":"DELETE","path":"/users/{}/{**}","raw":"/users/:id"},
    {"method":"GET","path":"/users/{}/{**}","raw":"/users/:id"},
    {"method":"PUT","path":"/users/{}/{**}","raw":"/users/:id"},
    {"method":"GET","path":"/users/profile"}
  ]
}
