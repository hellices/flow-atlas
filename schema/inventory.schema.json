{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:flow-atlas:schema:v1alpha1:inventory",
  "title": "Flow Atlas inventory",
  "description": "Candidates for writing a configuration. Lists what looks like components, route registrations and client requests; decides nothing.",
  "type": "object",
  "required": [
    "apiVersion",
    "kind",
    "provenance",
    "components",
    "routes",
    "calls",
    "apiDocuments"
  ],
  "additionalProperties": false,
  "properties": {
    "apiVersion": {
      "$ref": "urn:flow-atlas:schema:v1alpha1:model#/$defs/apiVersion"
    },
    "kind": {
      "const": "Inventory"
    },
    "provenance": {
      "$ref": "urn:flow-atlas:schema:v1alpha1:model#/$defs/provenance"
    },
    "components": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "path",
          "manifest"
        ],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "manifest": {
            "type": "string"
          },
          "note": {
            "type": "string",
            "description": "Why the component is named by its path: other manifests would give it the same name."
          }
        }
      }
    },
    "routes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "component",
          "file",
          "style",
          "count",
          "example"
        ],
        "additionalProperties": false,
        "properties": {
          "component": {
            "type": "string"
          },
          "file": {
            "type": "string"
          },
          "style": {
            "type": "string"
          },
          "count": {
            "type": "integer",
            "minimum": 1
          },
          "example": {
            "type": "string"
          }
        }
      }
    },
    "calls": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "component",
          "file",
          "count",
          "example"
        ],
        "additionalProperties": false,
        "properties": {
          "component": {
            "type": "string"
          },
          "file": {
            "type": "string"
          },
          "count": {
            "type": "integer",
            "minimum": 1
          },
          "example": {
            "type": "string"
          }
        }
      }
    },
    "apiDocuments": {
      "type": "array",
      "items": {
        "$ref": "urn:flow-atlas:schema:v1alpha1:model#/$defs/apiDocument"
      }
    }
  }
}
