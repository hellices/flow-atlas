{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:flow-atlas:schema:v1alpha1:diff",
  "title": "Flow Atlas diff",
  "description": "What changed in the flow between two revisions: surfaces, component edges and findings. provenance.externalParameters holds base and head as given; resolvedDependencies holds both commits.",
  "type": "object",
  "required": [
    "apiVersion",
    "kind",
    "provenance",
    "surfaces",
    "componentEdges",
    "findings",
    "chains"
  ],
  "additionalProperties": false,
  "properties": {
    "apiVersion": {
      "$ref": "urn:flow-atlas:schema:v1alpha1:model#/$defs/apiVersion"
    },
    "kind": {
      "const": "Diff"
    },
    "provenance": {
      "$ref": "urn:flow-atlas:schema:v1alpha1:model#/$defs/provenance"
    },
    "surfaces": {
      "type": "object",
      "required": [
        "added",
        "removed"
      ],
      "additionalProperties": false,
      "properties": {
        "added": {
          "type": "array",
          "items": {
            "$ref": "urn:flow-atlas:schema:v1alpha1:model#/$defs/surface"
          }
        },
        "removed": {
          "type": "array",
          "items": {
            "$ref": "urn:flow-atlas:schema:v1alpha1:model#/$defs/surface"
          }
        }
      }
    },
    "componentEdges": {
      "type": "object",
      "required": [
        "added",
        "removed"
      ],
      "additionalProperties": false,
      "properties": {
        "added": {
          "type": "array",
          "items": {
            "$ref": "urn:flow-atlas:schema:v1alpha1:model#/$defs/componentEdge"
          }
        },
        "removed": {
          "type": "array",
          "items": {
            "$ref": "urn:flow-atlas:schema:v1alpha1:model#/$defs/componentEdge"
          }
        }
      }
    },
    "findings": {
      "type": "object",
      "required": [
        "new",
        "resolved"
      ],
      "additionalProperties": false,
      "properties": {
        "new": {
          "type": "array",
          "items": {
            "$ref": "urn:flow-atlas:schema:v1alpha1:model#/$defs/finding"
          }
        },
        "resolved": {
          "type": "array",
          "items": {
            "$ref": "urn:flow-atlas:schema:v1alpha1:model#/$defs/finding"
          }
        }
      }
    },
    "chains": {
      "description": "Chains that appear, disappear, or reach different surfaces between the two revisions.",
      "type": "object",
      "required": [
        "added",
        "removed",
        "changed"
      ],
      "additionalProperties": false,
      "properties": {
        "added": {
          "type": "array",
          "items": {
            "$ref": "urn:flow-atlas:schema:v1alpha1:model#/$defs/chainId"
          }
        },
        "removed": {
          "type": "array",
          "items": {
            "$ref": "urn:flow-atlas:schema:v1alpha1:model#/$defs/chainId"
          }
        },
        "changed": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "added",
              "removed"
            ],
            "additionalProperties": false,
            "properties": {
              "id": {
                "$ref": "urn:flow-atlas:schema:v1alpha1:model#/$defs/chainId"
              },
              "added": {
                "type": "array",
                "items": {
                  "$ref": "urn:flow-atlas:schema:v1alpha1:model#/$defs/surfaceId"
                }
              },
              "removed": {
                "type": "array",
                "items": {
                  "$ref": "urn:flow-atlas:schema:v1alpha1:model#/$defs/surfaceId"
                }
              }
            }
          }
        }
      }
    },
    "flows": {
      "description": "Flows the change reaches, matched by name and their steps by stepId: a step it builds or loses, a chain step reaching other surfaces, a condition that moves. Present when the flows of both revisions were read.",
      "type": "object",
      "required": [
        "added",
        "removed",
        "changed"
      ],
      "additionalProperties": false,
      "properties": {
        "added": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "removed": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "changed": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "name",
              "conditions",
              "steps"
            ],
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string"
              },
              "conditions": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "type",
                    "was",
                    "now"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "type": {
                      "enum": [
                        "Ready",
                        "Resolved",
                        "Connected",
                        "ProducesListed",
                        "Documented"
                      ]
                    },
                    "was": {
                      "type": "object",
                      "required": [
                        "status",
                        "reason"
                      ],
                      "additionalProperties": false,
                      "properties": {
                        "status": {
                          "enum": [
                            "True",
                            "False",
                            "Unknown"
                          ]
                        },
                        "reason": {
                          "type": "string"
                        }
                      }
                    },
                    "now": {
                      "type": "object",
                      "required": [
                        "status",
                        "reason"
                      ],
                      "additionalProperties": false,
                      "properties": {
                        "status": {
                          "enum": [
                            "True",
                            "False",
                            "Unknown"
                          ]
                        },
                        "reason": {
                          "type": "string"
                        }
                      }
                    }
                  }
                }
              },
              "steps": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "stepId",
                    "target",
                    "change"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "stepId": {
                      "type": "string"
                    },
                    "target": {
                      "type": "string"
                    },
                    "change": {
                      "enum": [
                        "added",
                        "removed",
                        "retargeted",
                        "built",
                        "gone",
                        "reaches",
                        "runs"
                      ],
                      "description": "What the flow's text changed: added, removed, retargeted (was: the old target). What the code changed of a step the flow keeps: built (in the code now), gone (no longer), reaches (its chain reaches other surfaces). runs: the flow the step runs is one the change reaches."
                    },
                    "added": {
                      "type": "array",
                      "items": {
                        "$ref": "urn:flow-atlas:schema:v1alpha1:model#/$defs/surfaceId"
                      }
                    },
                    "removed": {
                      "type": "array",
                      "items": {
                        "$ref": "urn:flow-atlas:schema:v1alpha1:model#/$defs/surfaceId"
                      }
                    },
                    "was": {
                      "type": "string",
                      "description": "retargeted: the target the step named before."
                    }
                  }
                }
              },
              "order": {
                "description": "The stepIds both revisions keep, in each revision's order, where that order changed.",
                "type": "object",
                "required": [
                  "was",
                  "now"
                ],
                "additionalProperties": false,
                "properties": {
                  "was": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "now": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
