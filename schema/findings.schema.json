{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:flow-atlas:schema:v1alpha1:findings",
  "title": "Flow Atlas findings",
  "description": "The result of `atlas check`: every finding with its status against the baseline, exceptions and --since. Also written to last-check.json.",
  "type": "object",
  "required": [
    "apiVersion",
    "kind",
    "provenance",
    "items"
  ],
  "additionalProperties": false,
  "properties": {
    "apiVersion": {
      "$ref": "urn:flow-atlas:schema:v1alpha1:model#/$defs/apiVersion"
    },
    "kind": {
      "const": "Findings"
    },
    "provenance": {
      "$ref": "urn:flow-atlas:schema:v1alpha1:model#/$defs/provenance"
    },
    "since": {
      "type": "string"
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "finding",
          "status"
        ],
        "additionalProperties": false,
        "properties": {
          "finding": {
            "$ref": "urn:flow-atlas:schema:v1alpha1:model#/$defs/finding"
          },
          "status": {
            "enum": [
              "new",
              "baseline",
              "excepted",
              "expired-exception"
            ]
          },
          "note": {
            "type": "string"
          }
        }
      }
    },
    "calls": {
      "description": "How far check saw the calls: which it checked against routes, and which it could not.",
      "type": "object",
      "required": [
        "read",
        "checked",
        "matched",
        "unchecked",
        "documentOnly"
      ],
      "additionalProperties": false,
      "properties": {
        "read": {
          "type": "integer",
          "minimum": 0
        },
        "checked": {
          "description": "Calls to a component whose routes are read; FA002 checks them.",
          "type": "integer",
          "minimum": 0
        },
        "matched": {
          "description": "Of those, the calls that reach a route.",
          "type": "integer",
          "minimum": 0
        },
        "unchecked": {
          "description": "Calls to a component with no route source, which nothing checks.",
          "type": "integer",
          "minimum": 0
        },
        "documentOnly": {
          "description": "Calls that reach only routes their component's OpenAPI document declares with no handler in its route files.",
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "call",
              "at",
              "surface",
              "described"
            ],
            "additionalProperties": false,
            "properties": {
              "call": {
                "type": "string"
              },
              "at": {
                "$ref": "urn:flow-atlas:schema:v1alpha1:model#/$defs/place"
              },
              "surface": {
                "type": "string"
              },
              "described": {
                "$ref": "urn:flow-atlas:schema:v1alpha1:model#/$defs/place"
              }
            }
          }
        }
      }
    }
  }
}
